
QWidget { background: #0b0b08; color: #ffb000; font-family: "Courier New"; }
QTabWidget::pane { border: 2px solid #ffb000; }
QTabBar::tab {
  background: #11110c;
  border: 2px solid #ffb000;
  padding: 6px 12px;
  margin-right: 2px;
}
QTabBar::tab:selected { background: #1a1a12; }
QGroupBox {
  border: 2px solid #ffb000;
  margin-top: 10px;
  padding: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; }
QPushButton {
  background: #11110c;
  border: 2px solid #ffb000;
  padding: 6px 10px;
}
QPushButton:hover { background: #1a1a12; }
QPushButton:pressed { background: #0b0b08; }
QPushButton:disabled { color: #7a5a14; border-color: #7a5a14; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
  background: #0b0b08;
  border: 2px solid #ffb000;
  padding: 4px;
  selection-background-color: #ffb000;
  selection-color: #0b0b08;
}
QProgressBar { border: 2px solid #ffb000; background: #11110c; text-align: center; }
QProgressBar::chunk { background: #ffb000; }
