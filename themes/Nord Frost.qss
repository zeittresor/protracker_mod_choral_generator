
QWidget { background: #2e3440; color: #eceff4; }
QTabWidget::pane { border: 2px solid #88c0d0; }
QTabBar::tab {
  background: #3b4252;
  border: 2px solid #88c0d0;
  padding: 6px 12px;
  margin-right: 2px;
}
QTabBar::tab:selected { background: #434c5e; border-color: #a3be8c; }
QGroupBox {
  border: 2px solid #88c0d0;
  margin-top: 10px;
  padding: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #88c0d0; }
QPushButton {
  background: #3b4252;
  border: 2px solid #88c0d0;
  padding: 6px 10px;
}
QPushButton:hover { border-color: #a3be8c; }
QPushButton:pressed { background: #2e3440; }
QPushButton:disabled { background: #3b4252; color: #6b7280; border-color: #4c566a; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
  background: #3b4252;
  border: 2px solid #88c0d0;
  padding: 4px;
  selection-background-color: #a3be8c;
  selection-color: #2e3440;
}
QProgressBar { border: 2px solid #88c0d0; background: #3b4252; text-align: center; }
QProgressBar::chunk { background: #88c0d0; }
