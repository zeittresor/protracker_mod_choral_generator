
QWidget { background: #f6f4ff; color: #1f2937; }
QTabWidget::pane { border: 2px solid #7c3aed; }
QTabBar::tab {
  background: #e9d5ff;
  border: 2px solid #7c3aed;
  padding: 6px 12px;
  margin-right: 2px;
}
QTabBar::tab:selected { background: #ddd6fe; border-color: #06b6d4; }
QGroupBox {
  border: 2px solid #7c3aed;
  margin-top: 10px;
  padding: 8px;
  background: #f6f4ff;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 6px; color: #7c3aed; }
QPushButton {
  background: #ddd6fe;
  border: 2px solid #7c3aed;
  padding: 6px 10px;
}
QPushButton:hover { border-color: #06b6d4; }
QPushButton:pressed { background: #e9d5ff; }
QPushButton:disabled { background: #e5e7eb; color: #9ca3af; border-color: #c7c7c7; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QPlainTextEdit {
  background: #ffffff;
  border: 2px solid #7c3aed;
  padding: 4px;
  selection-background-color: #06b6d4;
  selection-color: #000000;
}
QProgressBar { border: 2px solid #7c3aed; background: #ffffff; text-align: center; }
QProgressBar::chunk { background: #06b6d4; }
